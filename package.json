{
  "name": "dsh-lead-panel",
  "version": "0.9.0",
  "description": "DSH 领导面板：领导可在 DSH 官方 / 官方 Codex（GPT）/ Claude Code 之间切换，外部 harness 的模型直接在面板里换、一键打开它自己的界面或配置；支持单平台、跨平台分工、同题会诊、跨平台流水线四种协作模式，并实时显示 token/金额/用时。团队与 harness 能力都来自官方，本插件只做面板",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-teams",
    "codex",
    "claude-code",
    "lead"
  ],
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "mutoharohfiqhiabcd-source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutoharohfiqhiabcd-source/dsh-lead-panel.git"
  },
  "homepage": "https://github.com/mutoharohfiqhiabcd-source/dsh-lead-panel#readme",
  "bugs": {
    "url": "https://github.com/mutoharohfiqhiabcd-source/dsh-lead-panel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/self-check.mjs && node test/host-smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "test/self-check.mjs",
    "test/host-smoke.mjs",
    "cordis.patch.yml",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
