{
  "name": "dsh-lead-panel",
  "version": "0.9.1",
  "description": "在 DSH 输入框旁加一个「领导」按钮：领导可在 DSH 官方 / Codex / Claude Code 之间切换，模型直接换、平台一键打开；单平台 / 分工 / 会诊 / 流水线四种协作模式，实时看 token、金额与用时。团队与 harness 能力都来自 DSH 官方，插件只做面板。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-teams",
    "codex",
    "claude-code",
    "lead"
  ],
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "mutoharohfiqhiabcd-source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutoharohfiqhiabcd-source/dsh-lead-panel.git"
  },
  "homepage": "https://github.com/mutoharohfiqhiabcd-source/dsh-lead-panel#readme",
  "bugs": {
    "url": "https://github.com/mutoharohfiqhiabcd-source/dsh-lead-panel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/self-check.mjs && node test/host-smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "test/self-check.mjs",
    "test/host-smoke.mjs",
    "cordis.patch.yml",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
